{
  "name": "TradingAccount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "propfirm",
        "personal",
        "demo"
      ],
      "default": "propfirm",
      "description": "Type de compte: PropFirm (avec r\u00e8gles) ou Personnel (sans restrictions)"
    },
    "propfirm": {
      "type": "string"
    },
    "broker": {
      "type": "string",
      "description": "Broker pour comptes personnels (ex: ICMarkets, Pepperstone)"
    },
    "account_size": {
      "type": "number"
    },
    "current_balance": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "USD",
        "GBP",
        "CHF"
      ],
      "default": "EUR"
    },
    "platform": {
      "type": "string",
      "enum": [
        "mt4",
        "mt5",
        "quantower",
        "ninjatrader",
        "ctrader",
        "tradingview",
        "other"
      ],
      "default": "mt5"
    },
    "phase": {
      "type": "string",
      "enum": [
        "backtest_local",
        "demo",
        "live"
      ],
      "default": "backtest_local"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blown",
        "passed"
      ],
      "default": "active"
    },
    "daily_drawdown_limit": {
      "type": "number",
      "description": "0 = pas de limite (comptes perso)"
    },
    "max_drawdown_limit": {
      "type": "number",
      "description": "0 = pas de limite"
    },
    "daily_profit_target": {
      "type": "number"
    },
    "overall_profit_target": {
      "type": "number",
      "description": "0 = pas de target"
    },
    "consistency_rule": {
      "type": "number",
      "default": 0
    },
    "leverage": {
      "type": "number",
      "default": 1,
      "description": "Levier pour comptes personnels"
    },
    "login": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "account_size"
  ]
}