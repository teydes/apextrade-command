{
  "name": "Trade",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "backtest_local",
        "demo",
        "live"
      ],
      "default": "backtest_local"
    },
    "symbol": {
      "type": "string",
      "default": "EURUSD"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "forex",
        "indices",
        "crypto",
        "commodities",
        "stocks",
        "futures"
      ],
      "default": "forex"
    },
    "direction": {
      "type": "string",
      "enum": [
        "LONG",
        "SHORT"
      ]
    },
    "entry_price": {
      "type": "number"
    },
    "exit_price": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit_1": {
      "type": "number"
    },
    "take_profit_2": {
      "type": "number"
    },
    "take_profit_3": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    },
    "lot_size": {
      "type": "number"
    },
    "pnl": {
      "type": "number"
    },
    "pnl_pct": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "cancelled"
      ],
      "default": "closed"
    },
    "result": {
      "type": "string",
      "enum": [
        "win",
        "loss",
        "breakeven"
      ]
    },
    "strategy": {
      "type": "string",
      "enum": [
        "ICT/SMC",
        "AMD/IFVG",
        "Footprint",
        "Order Book",
        "Pullback",
        "Breakout",
        "Range",
        "Trend Following",
        "Mean Reversion",
        "Scalping",
        "Mixed"
      ]
    },
    "pattern": {
      "type": "string",
      "description": "Pattern d\u00e9tect\u00e9 (OB, FVG, BOS, CHoCH, EQH, EQL, Liquidity, Pullback...)"
    },
    "session": {
      "type": "string",
      "enum": [
        "London",
        "New York",
        "Asian",
        "Pre-Market",
        "Sydney",
        "Overlap London-NY"
      ]
    },
    "entry_time": {
      "type": "string",
      "format": "date-time"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time"
    },
    "setup": {
      "type": "string"
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "M1",
        "M5",
        "M15",
        "M30",
        "H1",
        "H4",
        "D1",
        "W1"
      ]
    },
    "mistakes": {
      "type": "string"
    },
    "improvements": {
      "type": "string"
    },
    "screenshot_url": {
      "type": "string"
    },
    "signal_source": {
      "type": "string",
      "enum": [
        "webhook",
        "manual",
        "auto",
        "agent"
      ],
      "default": "manual"
    },
    "risk_reward": {
      "type": "number"
    },
    "news_impact": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "default": "none"
    },
    "commission": {
      "type": "number",
      "default": 0
    },
    "swap": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "symbol",
    "direction",
    "phase"
  ]
}