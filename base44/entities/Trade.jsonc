{
  "name": "Trade",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "backtest_local",
        "demo",
        "live"
      ],
      "default": "backtest_local"
    },
    "symbol": {
      "type": "string",
      "default": "NQ1!"
    },
    "direction": {
      "type": "string",
      "enum": [
        "LONG",
        "SHORT"
      ]
    },
    "entry_price": {
      "type": "number"
    },
    "exit_price": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit_1": {
      "type": "number"
    },
    "take_profit_2": {
      "type": "number"
    },
    "take_profit_3": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    },
    "pnl": {
      "type": "number"
    },
    "pnl_pct": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "cancelled"
      ],
      "default": "closed"
    },
    "result": {
      "type": "string",
      "enum": [
        "win",
        "loss",
        "breakeven"
      ]
    },
    "strategy": {
      "type": "string",
      "enum": [
        "ICT/SMC",
        "AMD/IFVG",
        "Footprint",
        "Order Book",
        "Mixed"
      ]
    },
    "session": {
      "type": "string",
      "enum": [
        "London",
        "New York",
        "Asian",
        "Pre-Market"
      ]
    },
    "entry_time": {
      "type": "string",
      "format": "date-time"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time"
    },
    "setup": {
      "type": "string",
      "description": "Description du setup (OB, FVG, BOS...)"
    },
    "mistakes": {
      "type": "string",
      "description": "Erreurs identifi\u00e9es"
    },
    "improvements": {
      "type": "string",
      "description": "Am\u00e9liorations"
    },
    "screenshot_url": {
      "type": "string"
    },
    "signal_source": {
      "type": "string",
      "enum": [
        "webhook",
        "manual",
        "auto"
      ],
      "default": "manual"
    },
    "risk_reward": {
      "type": "number"
    },
    "news_impact": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "default": "none"
    }
  },
  "required": [
    "symbol",
    "direction",
    "phase"
  ]
}